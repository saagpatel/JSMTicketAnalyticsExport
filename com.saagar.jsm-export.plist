<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.saagar.jsm-export</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Update this path to your Python interpreter -->
        <string>/usr/local/bin/python3</string>
        <string>/Users/d/Projects/JSMTicketAnalyticsExport/jsm_export.py</string>
        <string>--month</string>
        <string>auto</string>
    </array>

    <!-- Run on the 1st of every month at 06:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/d/Analytics/JSM/logs/jsm-export-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/d/Analytics/JSM/logs/jsm-export-stderr.log</string>

    <!-- Restart if the job exits non-zero (transient network failures, etc.) -->
    <key>KeepAlive</key>
    <false/>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
